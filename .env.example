# -----------------------------------------------------------------------------
# BhangBosdha Environment Variables
# Copy this file to .env and replace the placeholder values with your actual keys
# -----------------------------------------------------------------------------

# Backend Configuration
MONGO_URI=mongodb://mongodb:27017/bhangbhosdha
REDIS_URL=redis://redis:6379

# Super Admin UID (Firebase Auth UID of the user with admin privileges)
SUPER_ADMIN_UID=your-firebase-uid-here

# Firebase Admin SDK Configuration (Backend Auth Verification)
FIREBASE_PROJECT_ID=your-firebase-project-id
# Firebase Private Key (from Service Account JSON — wrap in quotes)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour Private Key Here\n-----END PRIVATE KEY-----\n"
# Optional: Firebase Public Key for JWT verification
#FIREBASE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYour Public Key Here\n-----END PUBLIC KEY-----"

# Firebase Client Configuration (Frontend Auth)
# Find these in Firebase Console -> Project Settings -> General -> Web Apps
NEXT_PUBLIC_FIREBASE_API_KEY=your-client-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
