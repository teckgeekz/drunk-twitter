# -----------------------------------------------------------------------------
# BhangBosdha Environment Variables Example
# Copy this file to .env and replace the placeholder values with your actual keys
# -----------------------------------------------------------------------------

# Backend Configuration (Optional overrides for Docker network)
MONGO_URI=mongodb://mongodb:27017/bhangbhosdha
REDIS_URL=redis://redis:6379

# Firebase Admin SDK Configuration (Backend Auth Verification)
# Provide your Firebase Project ID and Public Key for JWT token verification
FIREBASE_PROJECT_ID=your-firebase-project-id
# Ensure the public key is wrapped in quotes if it contains newlines
FIREBASE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYour Public Key Here\n-----END PUBLIC KEY-----"

# Firebase Client Configuration (Frontend Auth)
# Find these in your Firebase Project Settings -> General -> Web Apps
NEXT_PUBLIC_FIREBASE_API_KEY=your-client-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
